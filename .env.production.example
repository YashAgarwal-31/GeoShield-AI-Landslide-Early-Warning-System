# GeoShield production-style local stack
# Copy to .env.production and replace every placeholder before use.

POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
GEOSHIELD_ADMIN_EMAIL=admin@example.com
GEOSHIELD_ADMIN_PASSWORD=replace-with-a-strong-admin-password
GEOSHIELD_ADMIN_NAME=GeoShield Admin

# Real gateway/sensor ingestion
SENSOR_INGEST_ENABLED=true
SENSOR_INGEST_API_KEY=replace-with-a-long-random-gateway-secret

# Bundled reference station metadata can be loaded into a new academic DB.
AUTO_SEED_REFERENCE_DATA=true

# Open-Meteo live lookup with cache/fallback.
WEATHER_LIVE_ENABLED=true

# Operational ML safety: never silently train synthetic data in production.
ALLOW_SYNTHETIC_MODEL_FALLBACK=false

# Citizen evidence upload limit (10 MiB default).
REPORT_UPLOAD_MAX_BYTES=10485760

# Live geospatial/weather/flood providers (fail soft to labelled fallback data)
SRTM_LIVE_ENABLED=true
SENTINEL2_LIVE_ENABLED=true
IMD_LIVE_ENABLED=true
FLOOD_LIVE_ENABLED=true

# Optional out-of-band notifications
SMS_NOTIFICATIONS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_RECIPIENTS=
PUSH_NOTIFICATIONS_ENABLED=false
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_ACCESS_TOKEN=

# Standards-based browser/PWA Web Push
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional district-specific SMS routing example:
# ALERT_SMS_RECIPIENTS_EAST_KHASI_HILLS=+911234567890,+919876543210
