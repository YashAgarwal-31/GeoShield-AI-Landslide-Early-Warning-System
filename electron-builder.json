{
  "appId": "com.geoshield.app",
  "productName": "GeoShield",
  "copyright": "Copyright © 2026 Team GeoShield",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "electron/**/*",
    "branding/team_logo.png"
  ],
  "extraResources": [
    {
      "from": "backend",
      "to": "backend",
      "filter": [
        "**/*",
        "!**/__pycache__/**",
        "!**/*.pyc",
        "!venv/**",
        "!.venv/**"
      ]
    },
    {
      "from": "datasets",
      "to": "datasets",
      "filter": [
        "processed/**/*"
      ]
    },
    {
      "from": "frontend/dist",
      "to": "frontend/dist",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "branding/team_logo.png",
      "to": "branding/team_logo.png"
    }
  ],
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "tar.gz",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "branding/team_logo.png",
    "category": "Science;Education",
    "description": "AI-Based Early Warning & Landslide Risk Monitoring System",
    "maintainer": "Team GeoShield <team@geoshield.dev>",
    "synopsis": "Landslide Monitoring for North Eastern India"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "dir",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "branding/team_logo.png",
    "extraResources": [
      {
        "from": "runtime/python",
        "to": "runtime/python",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "GeoShield",
    "deleteAppDataOnUninstall": false,
    "allowElevation": true,
    "runAfterFinish": true,
    "artifactName": "GeoShield-${version}-Setup.${ext}"
  },
  "mac": {
    "target": [
      "dmg"
    ],
    "icon": "branding/team_logo.png",
    "category": "public.app-category.education"
  },
  "compression": "maximum",
  "portable": {
    "artifactName": "GeoShield-${version}-Portable.${ext}"
  }
}
