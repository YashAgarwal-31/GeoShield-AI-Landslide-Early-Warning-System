# Optional live weather integration. Disabled by default for deterministic,
# offline-safe demonstrations.
WEATHER_LIVE_ENABLED=false
WEATHER_REQUEST_TIMEOUT_SECONDS=5
WEATHER_CACHE_TTL_SECONDS=900
WEATHER_MAX_AGE_SECONDS=21600

# Cached satellite snapshot freshness threshold (6 hours).
SATELLITE_MAX_AGE_SECONDS=21600

# Optional alternate snapshot path for Docker or local deployments.
# SATELLITE_DATA_PATH=/absolute/path/to/real_satellite_data.json
