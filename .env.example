# GeoShield operational / Phase 5 configuration

# Runtime profile: demo (local presentation) or production.
APP_ENV=demo

# JWT: local demo mode can use the built-in demo-only key.
# Production MUST set a random JWT_SECRET with at least 32 characters.
# JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_EXPIRY_HOURS=24
ENABLE_DEMO_USERS=true

# Production login (required when APP_ENV=production and demo users are off).
# GEOSHIELD_ADMIN_EMAIL=admin@example.com
# GEOSHIELD_ADMIN_PASSWORD=use-a-secret-manager-and-at-least-12-characters
# GEOSHIELD_ADMIN_NAME=GeoShield Admin

# CORS: comma-separated explicit origins. Leave empty for same-origin production.
# Include https://localhost when an installed Capacitor Android client talks to
# this backend; the debug/local APK uses that WebView origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost

# Only enable when the app is behind a trusted reverse proxy that overwrites
# X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Administrative model retraining is disabled during normal operation.
MODEL_TRAINING_ENABLED=false
# MODEL_TRAINING_DATA_DIR=/absolute/path/to/datasets
# Demo/testing may use an explicit synthetic fallback; production should keep false.
ALLOW_SYNTHETIC_MODEL_FALLBACK=true

# Real sensor/gateway ingestion is disabled until explicitly configured.
# Enable it only when a gateway key is set.
SENSOR_INGEST_ENABLED=false
# SENSOR_INGEST_API_KEY=replace-with-a-long-random-gateway-secret

# Seed the bundled reference monitoring locations on an empty database.
# Recommended true for local academic runs; false for a production deployment
# that will provision its own stations.
AUTO_SEED_REFERENCE_DATA=true


# Keyless live Open-Meteo integration. Enabled by default; set false for a
# deterministic offline-only demonstration. Failed/slow live requests fall
# back safely to cached or seeded data and are labelled in the UI.
WEATHER_LIVE_ENABLED=true
WEATHER_REQUEST_TIMEOUT_SECONDS=5
WEATHER_CACHE_TTL_SECONDS=900
WEATHER_MAX_AGE_SECONDS=21600

# Cached satellite snapshot freshness threshold (6 hours).
SATELLITE_MAX_AGE_SECONDS=21600

# Optional alternate snapshot path for Docker or local deployments.
# SATELLITE_DATA_PATH=/absolute/path/to/real_satellite_data.json

# Citizen evidence uploads.
REPORT_UPLOAD_MAX_BYTES=10485760
# REPORT_UPLOAD_DIR=/absolute/path/to/persistent/report-uploads
