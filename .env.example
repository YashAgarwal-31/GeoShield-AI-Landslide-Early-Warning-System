# GeoShield Phase 4 configuration

# Runtime profile: demo (local presentation) or production.
APP_ENV=demo

# JWT: local demo mode can use the built-in demo-only key.
# Production MUST set a random JWT_SECRET with at least 32 characters.
# JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_EXPIRY_HOURS=24
ENABLE_DEMO_USERS=true

# CORS: comma-separated explicit origins. Leave empty for same-origin production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Only enable when the app is behind a trusted reverse proxy that overwrites
# X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Administrative model retraining is disabled during normal operation.
MODEL_TRAINING_ENABLED=false
# MODEL_TRAINING_DATA_DIR=/absolute/path/to/datasets

# Optional live weather integration. Disabled by default for deterministic,
# offline-safe demonstrations.
WEATHER_LIVE_ENABLED=false
WEATHER_REQUEST_TIMEOUT_SECONDS=5
WEATHER_CACHE_TTL_SECONDS=900
WEATHER_MAX_AGE_SECONDS=21600

# Cached satellite snapshot freshness threshold (6 hours).
SATELLITE_MAX_AGE_SECONDS=21600

# Optional alternate snapshot path for Docker or local deployments.
# SATELLITE_DATA_PATH=/absolute/path/to/real_satellite_data.json
